FRONTIER_ENV=development
FRONTIER_DATABASE_URL=postgresql+asyncpg://frontier:frontier_local@localhost:5432/frontier
FRONTIER_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FRONTIER_FAKE_PROVIDER=true
FRONTIER_MOCK_AUTH=false
FRONTIER_WRITEBACK_ENABLED=false
FRONTIER_DB_PORT=5432
FRONTIER_API_PORT=8000
# Vite reads this shell variable when API uses a different local port.
FRONTIER_API_PROXY=http://127.0.0.1:8000
# Generate secrets locally; never commit populated values.
FRONTIER_ENCRYPTION_KEY=


# Independent accounts are available without enabling development Mock identity.
FRONTIER_PASSWORD_AUTH=true
# Only this setting selects the runtime provider; FAKE_PROVIDER is a legacy compatibility flag.
FRONTIER_LLM_PROVIDER=local_rules
FRONTIER_OPENAI_API_KEY=
FRONTIER_OPENAI_MODEL=
FRONTIER_MODEL_USER_CALLS_PER_DAY=10
FRONTIER_MODEL_USER_TOKENS_PER_DAY=50000
FRONTIER_MODEL_GLOBAL_CALLS_PER_DAY=100
FRONTIER_MODEL_GLOBAL_TOKENS_PER_DAY=200000
# Configure the complete GitHub App group together; keep secrets server-side.
FRONTIER_GITHUB_APP_ID=
FRONTIER_GITHUB_CLIENT_ID=
FRONTIER_GITHUB_CLIENT_SECRET=
FRONTIER_GITHUB_PRIVATE_KEY=
FRONTIER_GITHUB_APP_SLUG=
# OAuth uses the same host/scheme for API and Web (ports may differ), HTTPS in production.
FRONTIER_PUBLIC_API_URL=http://localhost:8000
FRONTIER_PUBLIC_WEB_URL=http://localhost:5173
